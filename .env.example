# Copy this file to .env and replace the placeholders with values from:
# https://docs.google.com/spreadsheets/d/<GSHEET_ID>/edit#gid=<GSHEET_GID>

GSHEET_ID=your_google_sheets_document_id
GSHEET_GID=0

# Optional named tabs in the same spreadsheet. When either is set, these
# replace GSHEET_GID in the deployed dataset selector. Use each tab's actual gid.
GSHEET_GID_TAIWAN_2026=
GSHEET_GID_VAN_2025=
